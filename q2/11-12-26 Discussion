from abc import ABC, abstractmethod 

class Sensor(ABC):
    @abstractmethod
    def get_data(self):
        pass

class TempSensor(Sensor):
    def get_data(self):
        return "24 deg C"
    def __str__(self):
        return "24 deg C"
    
sensor = TempSensor()
print(sensor.get_data()) #prints 24 deg C
print(sensor) #prints 24 deg C
