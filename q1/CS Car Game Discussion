class Car:
    def __init__(self, brand, model, battery=33):
        self.brand = brand
        self.model = model
        self.battery = battery
    def go(self, distance):
        self.battery -= distance/25
        # 1wH : 25
        print("You travelled",distance,"km")
        print("Your", self.brand,self.model,"has", self.battery,"wH left\n")
    def charge(self, #time):
               wH):
        #self.battery += time*20 #1hr : 20wH
        #if self.battery > 100:
        #print("You charged and added",time*20,"wH to your battery")
        #print("Your", self.brand,self.model,"has", self.battery,"wH left\n")

        self.battery += wH
        print("You charged your car")
        print("Your", self.brand,self.model,"has", self.battery,"wH left\n")


brand = input("What is the brand of your car? ")
model = input("What is the model of your car? ")
myCar = Car(brand,model)
while myCar.battery > 0:
    action = input("What do you want to do? (go, charge) ").lower()
    if action == "go":
        distance = int(input("\tHow far? "))
        myCar.go(distance)
    elif action == "charge":
        wH = int(input("\tHow much to charge? "))
        myCar.charge(wH)
    else:
        print("Invalid action")
